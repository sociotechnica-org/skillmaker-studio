---
// PROTOTYPE route (usability remodel, 2026-08-05) — /prototype.
//
// Deliberately OUTSIDE the shipping shell at "/": this is a sandbox for
// arguing about where work happens and what a maker is looking at. It
// shares the brand CSS and nothing else, so it can be torn up freely and
// deleted in one commit. `astro.config.mjs` exempts this path from the
// dev SPA fallback.
import ProtoShell from "../app/proto/ProtoShell.tsx";
import "../styles/global.css";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Prototype — where the work is</title>
    <link rel="icon" href="data:," />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Special+Elite&family=Source+Serif+4:ital,opsz,wght@0,8..60,300;0,8..60,400;0,8..60,600;1,8..60,400&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="min-h-screen text-ink antialiased">
    <ProtoShell client:load />
  </body>
</html>
