---
// PROTOTYPE route (usability remodel, 2026-08-05) — /prototype.
//
// A copy of index.astro, pointed at the prototype shell. Same fonts, same
// pre-paint theme script, same body classes — so DARK MODE, the parchment
// ground and the type all behave exactly as they do at "/". The only
// difference is which shell mounts.
//
// `astro.config.mjs` exempts this path from the dev SPA fallback; the CLI's
// static server already serves it, because Astro emits it as
// dist/prototype/index.html and the server tries a directory index before
// falling back.
import ProtoShell from "../app/proto/ProtoShell.tsx";
import "../styles/global.css";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Skillmaker Studio — prototype</title>
    <link rel="icon" href="data:," />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Special+Elite&family=Source+Serif+4:ital,opsz,wght@0,8..60,300;0,8..60,400;0,8..60,600;1,8..60,400&display=swap"
      rel="stylesheet"
    />
    <!-- Apply the theme before paint so there's no light→dark flash.
         Verbatim from index.astro — the prototype shares the same
         localStorage key, so the toggle in the real sidebar carries your
         choice between "/" and here. -->
    <script is:inline>
      (function () {
        try {
          var stored = localStorage.getItem("sm-theme");
          var dark =
            stored === "dark" ||
            (stored !== "light" && window.matchMedia("(prefers-color-scheme: dark)").matches);
          if (dark) document.documentElement.classList.add("dark");
        } catch {}
      })();
    </script>
  </head>
  <body class="min-h-screen text-ink antialiased">
    <ProtoShell client:load />
  </body>
</html>
